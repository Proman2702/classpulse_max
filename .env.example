# Скопируйте в корневой .env для `docker compose up --build`.
# Только примеры: здесь нет рабочих токенов, паролей или ключей.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_MAX_BOT_USERNAME=your_bot_username
MINIAPP_PORT=8080

MAX_API_URL=https://platform-api2.max.ru
BOT_TOKEN=your_max_bot_token
MAX_BOT_USERNAME=your_bot_username
MINI_APP_URL=https://your-mini-app.example.com
# false — запустить бота без кнопки мини-приложения
MINI_APP_ENABLED=true
