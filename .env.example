# Скопируйте этот файл в bot/.env и подставьте реальные значения.
# Секреты в репозиторий не коммитятся: bot/.env в .gitignore.
MAX_API_URL=https://platform-api2.max.ru
BOT_TOKEN=your_max_bot_token
MAX_BOT_USERNAME=your_bot_username
MINI_APP_URL=https://your-mini-app.example.com
# false — запустить бота без кнопки мини-приложения
MINI_APP_ENABLED=true
